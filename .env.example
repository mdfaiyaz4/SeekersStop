DB_USERNAME=yourdbusername
DB_PASSWORD=yourpassword
DB_URL=jdbc:mysql://your-database-host:3306/job_portal
SERVER_PORT=8081
PORT=8081
CV_STORAGE_ROOT=uploads
# For Docker Compose, use a separate MySQL root credential; do not reuse DB_PASSWORD.
MYSQL_ROOT_PASSWORD=replace_with_a_separate_root_password
FRONTEND_URL=http://localhost:5173
# Generate your own JWT secret with: openssl rand -base64 32
JWT_SECRET=<base64-encoded-random-32-byte-secret>
